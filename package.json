{
  "name": "dev-services-showcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "build": "npm run build:client && npm run build:ssr && npm run prerender",
    "preview": "vite preview",
    "og:render": "node tools/og/render.mjs",
    "test:chatbot": "node --test tests/chatbot-matcher.test.mjs",
    "seo-check": "node scripts/seo-check.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.0.0",
    "vite": "^5.0.0"
  }
}
